# এই ফাইলটা গিটে থাকে, আসল .env থাকে না।
# নতুন মেশিনে:  cp .env.example .env  (Windows: copy .env.example .env)

# true  = ব্রাউজারের ভেতরের mock ডেটা (ব্যাকএন্ড ছাড়াই পুরো সাইট চলে)
# false = আসল Django REST API (backend/ এর সার্ভার চালু থাকতে হবে)
VITE_USE_MOCK=false

VITE_API_URL=http://127.0.0.1:8000/api/v1

# মিডিয়া ফাইলের বেস (Django MEDIA_URL / S3 / Cloudinary)
VITE_MEDIA_URL=http://127.0.0.1:8000
