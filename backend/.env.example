# এই ফাইলটা গিটে থাকে, আসল .env থাকে না।
# নতুন মেশিনে কাজ শুরু করতে:  cp .env.example .env  (Windows: copy)
# তারপর নিচের মানগুলো নিজের মতো বসিয়ে নিন।

# ---------------------------------------------------------------- মূল

# নতুন কি বানাতে:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=এখানে-৫০-অক্ষরের-এলোমেলো-কি-বসান

# লাইভে অবশ্যই False
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# অ্যাডমিন প্যানেলের ঠিকানা। লাইভে অনুমান করা কঠিন কিছু দিন
# (যেমন sb-control-9f2k/) — ডিফল্ট /admin/ এ বট সারাক্ষণ চেষ্টা করে।
DJANGO_ADMIN_URL=django-admin/

# ---------------------------------------------------------------- CORS

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# DEBUG=False হলে ফর্ম পোস্টের জন্য দরকার (যেমন Django admin)
CSRF_TRUSTED_ORIGINS=https://your-domain.com

# ------------------------------------------------------------ ডেটাবেস

# ডিফল্ট SQLite — কিছু ইনস্টল করতে হয় না
DB_ENGINE=django.db.backends.sqlite3

# PostgreSQL-এ যেতে চাইলে উপরের লাইনটা মুছে নিচেরগুলো চালু করুন
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=shopbazar
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=5432

# ------------------------------------------------------ পেমেন্ট গেটওয়ে

# SSLCommerz — একটাতেই বিকাশ, নগদ, রকেট, কার্ড ও ব্যাংক।
# পরীক্ষার sandbox অ্যাকাউন্ট ফ্রি: https://developer.sslcommerz.com
SSLCZ_STORE_ID=
SSLCZ_STORE_PASSWORD=
SSLCZ_SANDBOX=True

# ⚠️ গেটওয়ে পেমেন্ট শেষে এই ঠিকানায় ফিরে আসে, তাই এটা **ইন্টারনেট
# থেকে পৌঁছানো যায়** এমন হতে হবে। localhost দিলে SSLCommerz-এর
# সার্ভার আপনার মেশিনে পৌঁছাতেই পারবে না।
#
# লোকালে পরীক্ষা করতে একটা পাবলিক টানেল বানান:
#     ngrok http 8080
# তারপর সে যে https://xxxx.ngrok-free.app দেবে সেটা এখানে বসান।
SSLCZ_CALLBACK_BASE_URL=http://localhost:8080

# পেমেন্ট শেষে ক্রেতাকে সাইটের কোন ঠিকানায় ফেরত পাঠানো হবে
SSLCZ_FRONTEND_URL=http://localhost:8080
