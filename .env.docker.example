# docker compose-এর জন্য।  cp .env.docker.example .env.docker
#
# ⚠️ .env.docker গিটে যায় না (.gitignore-এ আছে) — আসল পাসওয়ার্ড
# এখানে বসানোর আগেই নিশ্চিত হয়ে নিন।

# ---------------------------------------------------------------- মূল

# নতুন কি:
#   docker compose run --rm backend python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-50-random-characters

DJANGO_DEBUG=False

# কনটেইনারের ভেতরে Django-র কাছে হোস্টনেম "backend", আর ব্রাউজার
# থেকে আসে "localhost" — দুটোই থাকতে হবে
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# ⚠️ HTTPS বসার আগ পর্যন্ত False। True দিলে Django প্রতিটি http
# রিকোয়েস্ট https-এ পাঠাবে, আর localhost:8080-এ SSL নেই বলে
# সাইটটাই খুলবে না। ডোমেইন + সার্টিফিকেট বসানোর পর True করুন।
DJANGO_HTTPS=False

DJANGO_ADMIN_URL=django-admin/

# ----------------------------------------------------- প্রথমবার চালু হলে

# ডেটাবেস একদম খালি থাকলে ডেমো পণ্য/দোকান বসাবে। দ্বিতীয়বার থেকে
# কিছু করে না — আপনার আসল ডেটার উপর কখনো বসবে না।
# আসল সাইটে false করে দিন।
SEED_ON_EMPTY=true

# অ্যাডমিন অ্যাকাউন্ট। দুইটাই দিলে কনটেইনার চালু হওয়ার সময় তৈরি হবে।
# খালি রাখলে কিছু হবে না — তখন নিজে বানাতে হবে:
#     docker compose exec backend python manage.py createsuperuser
#
# ⚠️ পাসওয়ার্ডটা নিজে বসান। এখানে কোনো ডিফল্ট রাখা হয়নি ইচ্ছে করেই —
# ডিফল্ট থাকলে বদলাতে ভুলে যাওয়া সহজ, আর তখন যে কেউ ঢুকে যেতে পারে।
DJANGO_SUPERUSER_PHONE=01700000000
DJANGO_SUPERUSER_FULL_NAME=অ্যাডমিন
DJANGO_SUPERUSER_PASSWORD=

# ------------------------------------------------------------ ডেটাবেস

# এই তিনটা নাম postgres ইমেজের — কনটেইনার প্রথমবার চালু হলে এই নামে
# ডেটাবেস আর ইউজার বানায়। Django-ও এগুলোই পড়ে (settings.py দেখুন),
# তাই একই মান দুই জায়গায় লিখতে হয় না।
#
# ⚠️ একবার `docker compose up` করার পর পাসওয়ার্ড বদলালে কাজ হবে না —
# ডেটাবেস তো আগের পাসওয়ার্ড নিয়ে তৈরি হয়ে গেছে। বদলাতে হলে
# `docker compose down -v` দিয়ে ভলিউম মুছে আবার শুরু করতে হবে
# (⚠️ তাতে ডেটাও মুছে যায়)।
POSTGRES_DB=shopbazar
POSTGRES_USER=shopbazar
POSTGRES_PASSWORD=change-this-password

# DB_ENGINE / DB_HOST / DB_PORT docker-compose.yml থেকেই আসে

# ---------------------------------------------------------------- CORS
# একই অরিজিন থেকে সব চলে (nginx প্রক্সি), তাই আলাদা অরিজিন লাগে না।
# আলাদা ডোমেইনে ফ্রন্টএন্ড রাখলে এখানে সেটা যোগ করুন।
CORS_ALLOWED_ORIGINS=http://localhost:8080
CSRF_TRUSTED_ORIGINS=http://localhost:8080
